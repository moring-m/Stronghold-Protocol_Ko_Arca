{
  "license": "GPL-3.0-or-later",
  "version": "0.2.3",
  "main": "server/index.js",
  "description": "明日方舟「卫戍协议：盟约」非官方同人联机网页复刻（1–4 人合作，Node.js 服务器 + 浏览器客户端）",
  "bugs": {
    "url": "https://github.com/sganggs/Stronghold-Protocol/issues"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sganggs/Stronghold-Protocol.git"
  },
  "scripts": {
    "assets:battle": "node tools/setup-battle-assets.mjs",
    "vendor": "node tools/vendor.mjs",
    "assets:ursus": "node tools/fetch-ursus-assets.mjs",
    "setup": "node tools/setup.mjs",
    "assets": "node tools/vendor.mjs && node tools/fetch-assets.mjs",
    "golden:update": "node tools/golden.mjs --update",
    "golden": "node tools/golden.mjs",
    "build-data": "node tools/build-data.mjs",
    "assets:voices": "node tools/build-battle-voices.mjs --refresh",
    "launch": "node scripts/launch.mjs",
    "dev:ursus": "node scripts/start-ursus.mjs",
    "postinstall": "node tools/vendor.mjs",
    "test": "node --test",
    "dev": "node --watch server/index.js",
    "doctor": "node tools/doctor.mjs",
    "start": "node server/index.js",
    "dev:recruits": "node scripts/start-recruits-test.mjs"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.2",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "homepage": "https://github.com/sganggs/Stronghold-Protocol#readme",
  "keywords": [
    "arknights",
    "auto-chess",
    "tower-defense",
    "co-op",
    "browser-game",
    "fan-game"
  ],
  "name": "stronghold-protocol-alliance",
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
